    {
      "parameters": {
        "jsCode": "return $input.all().map(item =\u003e {\n  const source = item.json || {};\n  const body = source.body || source;\n  let payload = body;\n\n  if (typeof body.json_data === \u0027string\u0027 \u0026\u0026 body.json_data.trim()) {\n    try {\n      payload = JSON.parse(body.json_data);\n    } catch (error) {\n      payload = body;\n    }\n  }\n\n  const record = payload.record || payload;\n  const hasMedia = payload.has_media === true || payload.has_media === \u0027true\u0027 || body.has_media === true || body.has_media === \u0027true\u0027;\n\n  const row = {\n    device_name: record.deviceName || record.device_name || \u0027\u0027,\n    device_model: record.deviceModel || record.device_model || \u0027\u0027,\n    device_os_version: record.osVersion || record.device_os_version || \u0027\u0027,\n    phone_number: record.phoneNumber || record.phone_number || \u0027\u0027,\n    contact_name: record.contactName || record.contact_name || \u0027\u0027,\n    call_type: record.callType || record.call_type || \u0027\u0027,\n    is_incoming: record.isIncoming ?? record.is_incoming ?? 0,\n    is_outgoing: record.isOutgoing ?? record.is_outgoing ?? 0,\n    is_missed: record.isMissed ?? record.is_missed ?? 0,\n    is_rejected: record.isRejected ?? record.is_rejected ?? 0,\n    is_answered: record.isAnswered ?? record.is_answered ?? 0,\n    start_time: record.startTime || record.start_time || \u0027\u0027,\n    answer_time: record.answerTime || record.answer_time || \u0027\u0027,\n    end_time: record.endTime || record.end_time || \u0027\u0027,\n    total_duration_seconds: record.totalDurationSeconds ?? record.total_duration_seconds ?? 0,\n    ring_duration_seconds: record.ringDurationSeconds ?? record.ring_duration_seconds ?? 0,\n    talk_duration_seconds: record.talkDurationSeconds ?? record.talk_duration_seconds ?? 0,\n    location_coords: record.locationCoords || record.location_coords || \u0027\u0027,\n    sim_slot: record.simSlot ?? record.sim_slot ?? 0,\n    carrier_name: record.carrierName || record.carrier_name || \u0027\u0027,\n    disconnect_cause: record.disconnectCause || record.disconnect_cause || \u0027\u0027,\n    has_media: String(hasMedia),\n    received_at: new Date().toISOString(),\n  };\n\n  return { json: row, binary: item.binary };\n});"

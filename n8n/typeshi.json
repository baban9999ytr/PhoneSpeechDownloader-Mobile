        "jsCode": "// 1. Pull the execution data array\nconst incomingItems = $input.all();\n\n// 2. Map through every item\nreturn incomingItems.map(currentItem => {\n  // The Extract Node parsed media_file1 and merged it right into the JSON root\n  const body = currentItem.json || {};\n  let parsed = {};\n\n  // Handle any nested stringified JSON if it exists\n  if (typeof body.json_data === 'string' && body.json_data.trim()) {\n    try {\n      parsed = JSON.parse(body.json_data);\n    } catch (error) {\n      parsed = {};\n    }\n  } else if (typeof body.json_data === 'object' && body.json_data !== null) {\n    parsed = body.json_data;\n  } else {\n    parsed = body;\n  }\n\n  // Look for the record keys\n  const recordData = parsed.record || parsed || {};\n  \n  // Check if an audio file (media_file0) actually arrived\n  const incomingBinary = currentItem.binary || {};\n  const hasMediaFile = incomingBinary.media_file0 !== undefined ? 'true' : 'false';\n\n  const row = {\n    device_name: recordData.deviceName || recordData.device_name || '',\n    device_model: recordData.deviceModel || recordData.device_model || '',\n    device_os_version: recordData.osVersion || recordData.device_os_version || '',\n    phone_number: recordData.phoneNumber || recordData.phone_number || '',\n    contact_name: recordData.contactName || recordData.contact_name || '',\n    call_type: recordData.callType || recordData.call_type || '',\n    is_incoming: recordData.isIncoming || recordData.is_incoming || 0,\n    is_outgoing: recordData.isOutgoing || recordData.is_outgoing || 0,\n    is_missed: recordData.isMissed || recordData.is_missed || 0,\n    is_rejected: recordData.isRejected || recordData.is_rejected || 0,\n    is_answered: recordData.isAnswered || recordData.is_answered || 0,\n    start_time: recordData.startTime || recordData.start_time || '',\n    answer_time: recordData.answerTime || recordData.answer_time || '',\n    end_time: recordData.endTime || recordData.end_time || '',\n    total_duration_seconds: recordData.totalDurationSeconds || recordData.total_duration_seconds || 0,\n    ring_duration_seconds: recordData.ringDurationSeconds || recordData.ring_duration_seconds || 0,\n    talk_duration_seconds: recordData.talkDurationSeconds || recordData.talk_duration_seconds || 0,\n    location_coords: recordData.locationCoords || recordData.location_coords || '',\n    sim_slot: recordData.simSlot || recordData.sim_slot || 0,\n    carrier_name: recordData.carrierName || recordData.carrier_name || '',\n    disconnect_cause: recordData.disconnectCause || recordData.disconnect_cause || '',\n    has_media: hasMediaFile,\n    received_at: new Date().toISOString(),\n  };\n\n  // Move the audio file to 'media_file' so the next node can write it to disk\n  const outputBinary = {};\n  if (incomingBinary.media_file0) {\n    outputBinary.media_file = incomingBinary.media_file0;\n  }\n\n  return { json: row, binary: outputBinary };\n});"
